---
/**
 * BaseLayout — the only layout. Every page renders through it.
 *
 * FONTS: imported here, self-hosted via Fontsource, never a runtime CDN call
 * (CLAUDE.md §1). Swap these two imports when you change recipe — the family
 * names are wired through --face-display / --face-body in tokens.css §2.
 *
 * The <script> for motion.ts is a plain Astro script: bundled, hashed, and
 * `type="module"` (therefore deferred), so GSAP never blocks render.
 */
/* Archivo is imported from its WIDTH-axis build, not the standard one: the
   display voice is set expanded (tokens.css §4, --face-display-stretch).
   Three families is one over the house limit and the reason is in tokens.css
   §2 — the mono is the drawing's annotation voice, not decoration. */
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/manrope/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";

/**
 * The display face is preloaded, and nothing else is (CLAUDE.md §6).
 *
 * The two-axis Archivo is 90KB against 35KB for the weight-only build. That
 * 55KB buys the width axis, which is the identity: the display voice on this
 * site is EXPANDED, the way an architectural sheet title is set, and there is
 * no way to fake that with tracking. It is paid for honestly rather than
 * hidden — this page carries no photography at all, so its total transfer is
 * roughly a third of a normal build of the same page.
 *
 * Preloading it means the h1 — which IS the LCP element here, there being no
 * hero image — swaps from the fallback in the first paint rather than the
 * third. `?url` gives the hashed, emitted path so this can never rot.
 */
import archivoDisplay from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";

import "../styles/tokens.css";
import "../styles/base.css";

import { SITE } from "../config/site";
import { useTranslations, localeFromUrl, type Locale } from "../i18n/ui";
import SEOHead from "../components/core/SEOHead.astro";
import SiteNav, { type NavLink } from "../components/core/SiteNav.astro";
import Footer from "../components/core/Footer.astro";
import ConceptBadge from "../components/core/ConceptBadge.astro";
import AnnouncementBar from "../components/core/AnnouncementBar.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  faq?: { question: string; answer: string }[];
  priceRange?: string;
  navLinks?: NavLink[];
  announcement?: {
    message: string;
    href?: string;
    linkLabel?: string;
    id?: string;
  };
  /** Adds the film-grain overlay. Recipe-dependent. */
  grain?: boolean;
  /** Sticky call bar on mobile. On by default — small businesses live on calls. */
  stickyCall?: boolean;
}

const {
  title,
  description,
  path = "/",
  image,
  noindex,
  faq,
  priceRange,
  navLinks = [],
  announcement,
  grain = false,
  stickyCall = true,
} = Astro.props;

const locale: Locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEOHead
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      faq={faq}
      priceRange={priceRange}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={archivoDisplay}
      crossorigin
    />
    <slot name="head" />
  </head>

  <body class:list={[grain && "has-grain", stickyCall && "has-sticky-call"]}>
    <a class="skip-link" href="#main">{t("skip.content")}</a>

    {announcement && <AnnouncementBar {...announcement} />}

    <SiteNav locale={locale} links={navLinks} current={path} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} links={navLinks} />

    {
      stickyCall && (
        <div class="sticky-call no-print">
          <a class="btn btn--block" href={`tel:${SITE.phoneHref}`}>
            {t("cta.callNow")} · {SITE.phone}
          </a>
        </div>
      )
    }

    {SITE.isConcept && <ConceptBadge locale={locale} />}

    <script>
      import "../lib/motion";
    </script>

    <style>
      /* Mobile-only sticky call bar. Desktop has the number in the header, so
         this would be redundant clutter above the nav breakpoint. */
      .sticky-call {
        position: fixed;
        inset-inline: 0;
        inset-block-end: 0;
        z-index: var(--z-sticky);
        padding: var(--space-2xs);
        background-color: var(--color-canvas);
        border-block-start: var(--border-hair) solid var(--color-line);
        /* Clear the iOS home indicator. */
        padding-block-end: calc(var(--space-2xs) + env(safe-area-inset-bottom));
      }

      /* Reserve the bar's height so it never covers the end of the footer. */
      :global(body.has-sticky-call) {
        padding-block-end: 4.25rem;
      }

      @media (min-width: 60em) {
        .sticky-call {
          display: none;
        }
        :global(body.has-sticky-call) {
          padding-block-end: 0;
        }
      }
    </style>
  </body>
</html>
