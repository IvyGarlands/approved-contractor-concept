---
/**
 * BaseLayout — the only layout. Every page renders through it.
 *
 * FONTS: imported here, self-hosted via Fontsource, never a runtime CDN call
 * (CLAUDE.md §1). Swap these two imports when you change recipe — the family
 * names are wired through --face-display / --face-body in tokens.css §2.
 *
 * The <script> for motion.ts is a plain Astro script: bundled, hashed, and
 * `type="module"` (therefore deferred), so GSAP never blocks render.
 */
/* TWO families, which is the house limit, and there is no mono — see
   tokens.css §2 for why that is a design constraint rather than an omission.

   Source Serif 4 is imported from its WEIGHT-axis build. It also ships an
   OPTICAL-SIZE build, and that is deliberately not used: build 004 made live
   optical sizing its typographic signature, and taking the same trick one
   build later would be the studio tic the differentiation log exists to catch.
   Here the display voice is carried by weight (900 in the stamp) and by the
   genre contrast against Outfit, not by an axis. */
import "@fontsource-variable/source-serif-4/wght.css";
import "@fontsource-variable/outfit/wght.css";

/**
 * The display face is preloaded, and nothing else is (CLAUDE.md §6).
 *
 * The h1 is one of the two LCP candidates here — this build carries real
 * photography for the first time in four, so the hero print competes with it —
 * and both need to be right at first paint. Preloading the roman means the
 * headline swaps from Georgia in the first paint rather than the third, which
 * matters more than usual because Source Serif 4 and Georgia are close enough
 * that a late swap is a visible reflow rather than a jump.
 *
 * Outfit is NOT preloaded. It carries body copy and record fields, all of it
 * below the headline, and a second preload competes with the hero image for
 * the same early bandwidth.
 *
 * `?url` gives the hashed, emitted path, so this can never rot.
 */
import serifDisplay from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";

import "../styles/tokens.css";
import "../styles/base.css";

import { SITE } from "../config/site";
import { useTranslations, localeFromUrl, type Locale } from "../i18n/ui";
import SEOHead from "../components/core/SEOHead.astro";
import SiteNav, { type NavLink } from "../components/core/SiteNav.astro";
import Footer from "../components/core/Footer.astro";
import ConceptBadge from "../components/core/ConceptBadge.astro";
import AnnouncementBar from "../components/core/AnnouncementBar.astro";

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  faq?: { question: string; answer: string }[];
  priceRange?: string;
  navLinks?: NavLink[];
  announcement?: {
    message: string;
    href?: string;
    linkLabel?: string;
    id?: string;
  };
  /** Adds the film-grain overlay. Recipe-dependent. */
  grain?: boolean;
  /** Sticky call bar on mobile. On by default — small businesses live on calls. */
  stickyCall?: boolean;
}

const {
  title,
  description,
  path = "/",
  image,
  noindex,
  faq,
  priceRange,
  navLinks = [],
  announcement,
  grain = false,
  stickyCall = true,
} = Astro.props;

const locale: Locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <SEOHead
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      faq={faq}
      priceRange={priceRange}
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={serifDisplay}
      crossorigin
    />
    <slot name="head" />
  </head>

  <body class:list={[grain && "has-grain", stickyCall && "has-sticky-call"]}>
    <a class="skip-link" href="#main">{t("skip.content")}</a>

    {announcement && <AnnouncementBar {...announcement} />}

    <SiteNav locale={locale} links={navLinks} current={path} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} links={navLinks} />

    {
      stickyCall && (
        <div class="sticky-call no-print">
          <a class="btn btn--block" href={`tel:${SITE.phoneHref}`}>
            {t("cta.callNow")} · {SITE.phone}
          </a>
        </div>
      )
    }

    {SITE.isConcept && <ConceptBadge locale={locale} />}

    <script>
      import "../lib/motion";
    </script>

    <style>
      /* Mobile-only sticky call bar. Desktop has the number in the header, so
         this would be redundant clutter above the nav breakpoint. */
      .sticky-call {
        position: fixed;
        inset-inline: 0;
        inset-block-end: 0;
        z-index: var(--z-sticky);
        padding: var(--space-2xs);
        background-color: var(--color-canvas);
        border-block-start: var(--border-hair) solid var(--color-line);
        /* Clear the iOS home indicator. */
        padding-block-end: calc(var(--space-2xs) + env(safe-area-inset-bottom));
      }

      /* Reserve the bar's height so it never covers the end of the footer. */
      :global(body.has-sticky-call) {
        padding-block-end: 4.25rem;
      }

      @media (min-width: 60em) {
        .sticky-call {
          display: none;
        }
        :global(body.has-sticky-call) {
          padding-block-end: 0;
        }
      }
    </style>
  </body>
</html>
