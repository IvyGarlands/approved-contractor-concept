---
/**
 * HeroElevation — a front elevation, drawn, with the trades called out on it.
 *
 * WHY THIS EXISTS. Approved Contractor only works on the exterior of a house:
 * the one part the owner never looks at and every neighbour does. In
 * architecture the drawing of that face is called an ELEVATION. So the hero is
 * one — a line drawing of a facade, annotated the way a plan sheet is
 * annotated, with a numbered bubble on a leader for each trade and an overall
 * dimension across the bottom.
 *
 * IT IS ALSO THE ANSWER TO HAVING NO PHOTOGRAPHY. This client supplied zero
 * job photos, so Built Well's natural signature (a pinned before/after) was
 * unbuildable and an FPO field in the hero would have killed the demo. A drawn
 * hero needs no photograph, ships honestly, and has a real performance
 * dividend: the LCP element is the headline text, and the page downloads no
 * hero image at all.
 *
 * SIGNATURE MOMENT (CLAUDE.md §4a) — this component owns the page's ONE
 * signature moment and nothing else on the page may take it. The moment is a
 * single gesture in two beats: the leaders extend from their bubbles to the
 * elements they name, then the overall dimension draws across the whole
 * facade and its label appears. The drawing gets annotated, then measured.
 *
 * The three constraints that govern the signature tier:
 *   1. STATIC COMPOSITION STANDS ALONE. With JS off, every leader, bubble,
 *      label and dimension is already drawn, at rest, exactly where it lands.
 *      The hidden start state is scoped to .js-motion, which motion.ts only
 *      adds when it is alive AND reduced motion is off.
 *   2. REDUCED MOTION COLLAPSES IT. --sig-leader-* go to 0 in tokens.css §11,
 *      and .js-motion is never added at all under prefers-reduced-motion.
 *   3. THE BUDGET DOES NOT MOVE. Transform and opacity only. No GSAP: the
 *      whole effect is CSS transitions plus a ~10-line IntersectionObserver,
 *      which is cheaper than the reveal system it would otherwise borrow.
 *
 * The headline is deliberately NOT masked-reveal type. With no hero image the
 * h1 IS the LCP element, and a masked reveal starts it invisible. It uses the
 * engine's CSS-keyframe hero settle instead, which animates from a visible
 * state (CLAUDE.md §4).
 *
 * CALLOUT ORDER. `callouts` must arrive in the same order as the services
 * collection, because the bubble numbers here and the index numbers in
 * ServiceLegend are both derived from position — that is what lets the
 * drawing and the key decode each other. The drawing has exactly six anchor
 * positions because the facade has six annotated elements; a seventh service
 * appears in the legend and not on the drawing.
 */
interface Props {
  eyebrow: string;
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  /** Small reassurance under the button. */
  note?: string;
  /** Short labels, in services-collection order. First six are drawn. */
  callouts: string[];
  /** The phrase the overall dimension measures out. The punchline. */
  dimension: string;
  /** Describes the whole drawing for assistive tech. */
  drawingAlt: string;
  id?: string;
}

const {
  eyebrow,
  heading,
  body,
  ctaLabel,
  ctaHref,
  note,
  callouts,
  dimension,
  drawingAlt,
  id,
} = Astro.props;

/**
 * Drawing geometry. This is the component's own mechanics, not the business's
 * voice, so it lives here rather than in a collection (CLAUDE.md §3).
 *
 *   bx, by   the numbered bubble, out in the annotation margin
 *   tx, ty   where the leader touches the thing it names
 *   side     which margin the bubble sits in — drives the leader's anchor
 */
const ANCHORS = [
  { side: "left", bx: 150, by: 185, tx: 350, ty: 206 }, // 01 gable field
  { side: "left", bx: 150, by: 392, tx: 262, ty: 374 }, // 02 window sill
  { side: "right", bx: 750, by: 262, tx: 505, ty: 272 }, // 03 open wall
  { side: "right", bx: 750, by: 352, tx: 655, ty: 352 }, // 04 garage door
  { side: "right", bx: 750, by: 160, tx: 612, ty: 199 }, // 05 roof slope
  { side: "left", bx: 150, by: 300, tx: 235, ty: 300 }, // 06 shutter
] as const;

const drawn = ANCHORS.map((a, i) => ({
  ...a,
  n: String(i + 1).padStart(2, "0"),
  label: callouts[i] ?? "",
})).filter((c) => c.label);

/** Bubble radius, in user units. The leader starts at its edge, not its centre. */
const R = 15;
---

<section id={id} class="hero-el">
  <div class="container container--xl">
    <div class="hero-el__head">
      <p class="annot hero-el__sheet" data-hero-settle>{eyebrow}</p>

      {/* LCP text. Painted at first paint, settled from a VISIBLE state. */}
      <h1 class="hero-el__heading">{heading}</h1>

      <div class="hero-el__intro" data-hero-settle>
        <p class="hero-el__body">{body}</p>

        <div class="hero-el__actions">
          <a class="btn btn--large" href={ctaHref}>{ctaLabel}</a>
          {note && <p class="annot hero-el__note">{note}</p>}
        </div>
      </div>
    </div>

    <figure class="hero-el__figure" data-elevation>
      {/*
        `slice` rather than the usual `meet` is the whole responsive strategy.
        The viewBox is one fixed composition — house centred at x=450, with an
        annotation margin either side. Because the SVG is told to COVER its
        box, changing only the element's aspect-ratio at a breakpoint changes
        how much of that margin is visible: wide box, full annotation; narrow
        box, the margins crop away and the house fills the frame. One drawing,
        one viewBox, one CSS line — not a second design for phones.
      */}
      <svg
        class="hero-el__svg"
        viewBox="-55 96 1010 344"
        preserveAspectRatio="xMidYMid slice"
        role="img"
        aria-labelledby={`${id ?? "hero"}-drawing-title`}
      >
        <title id={`${id ?? "hero"}-drawing-title`}>{drawingAlt}</title>

        <defs>
          {/*
            Both tiles carry an opaque paper ground. Without it the pattern is
            transparent and every line underneath — the roof's inner edge, the
            gable's own base — reads straight through the wall it is supposed
            to be hidden behind.
          */}

          {/* Lap siding. Horizontal courses, drawn once and tiled. */}
          <pattern
            id="ac-lap"
            width="24"
            height="15"
            patternUnits="userSpaceOnUse"
          >
            <rect width="24" height="15" class="hero-el__paper" />
            <path d="M0 14.5 H24" class="hero-el__hatch" />
          </pattern>

          {/* Stucco. A stipple, not a texture image — one tile, no request. */}
          <pattern
            id="ac-stucco"
            width="9"
            height="9"
            patternUnits="userSpaceOnUse"
          >
            <rect width="9" height="9" class="hero-el__paper" />
            <circle cx="2" cy="2" r="0.8" class="hero-el__stipple" />
            <circle cx="6.5" cy="6" r="0.7" class="hero-el__stipple" />
          </pattern>
        </defs>

        <g class="hero-el__drawing">
          {/* Gable wall — the siding field. Drawn first, wall covers its base. */}
          <path
            d="M200 246 L450 124 L700 246 Z"
            class="hero-el__field"
            fill="url(#ac-lap)"
          />

          {/* Main wall — the stucco field. */}
          <rect
            x="200"
            y="240"
            width="500"
            height="178"
            class="hero-el__field"
            fill="url(#ac-stucco)"
          />

          {/* Roof edge with its overhang. Stroked, so the rake reads as one line. */}
          <path d="M172 256 L450 120 L728 256" class="hero-el__roof" />

          {/* Gable vent. */}
          <path
            d="M436 176 h28 v28 h-28 Z M436 183 h28 M436 190 h28 M436 197 h28"
            class="hero-el__detail"
          />

          {/* Picture window, its mullion, its sill. */}
          <rect x="248" y="286" width="104" height="82" class="hero-el__opening" />
          <path
            d="M300 286 V368 M248 327 H352 M240 372 H360 M244 368 H356"
            class="hero-el__detail"
          />

          {/* Shutters, louvred, one either side. */}
          <g class="hero-el__detail">
            <path d="M226 286 h18 v82 h-18 Z" />
            <path d="M226 300 h18 M226 314 h18 M226 328 h18 M226 342 h18 M226 356 h18" />
            <path d="M356 286 h18 v82 h-18 Z" />
            <path d="M356 300 h18 M356 314 h18 M356 328 h18 M356 342 h18 M356 356 h18" />
          </g>

          {/* Front door, panelled, with a knob. */}
          <rect x="420" y="306" width="52" height="112" class="hero-el__opening" />
          <path
            d="M428 316 h36 v40 h-36 Z M428 366 h36 v42 h-36 Z"
            class="hero-el__detail"
          />
          <circle cx="464" cy="362" r="2.5" class="hero-el__stipple" />

          {/* Garage door, four panels. */}
          <rect x="520" y="300" width="152" height="118" class="hero-el__opening" />
          <path
            d="M520 330 h152 M520 359 h152 M520 388 h152"
            class="hero-el__detail"
          />

          {/* Ground line. The heaviest rule on the drawing, as it should be. */}
          <path d="M120 418 H780" class="hero-el__ground" />
        </g>

        {/*
          Annotation. Hidden below the breakpoint where the labels would be
          too small to read — the drawing above simply scales up to fill the
          space it gives back.
        */}
        <g class="hero-el__annot">
          {
            drawn.map((c, i) => (
              <g style={`--i:${i}`}>
                {/* The leader. Its own group so the scaleX that draws it does
                    not also squash the bubble and the label. */}
                <g
                  class:list={[
                    "hero-el__leader-g",
                    `hero-el__leader-g--${c.side}`,
                  ]}
                >
                  <path
                    class="hero-el__leader"
                    d={`M${c.side === "left" ? c.bx + R : c.bx - R} ${c.by} L${c.tx} ${c.ty}`}
                  />
                </g>

                <g class="hero-el__bubble-g">
                  <circle cx={c.tx} cy={c.ty} r="3.5" class="hero-el__tip" />
                  <circle cx={c.bx} cy={c.by} r={R} class="hero-el__bubble" />
                  <text
                    x={c.bx}
                    y={c.by}
                    class="hero-el__num"
                    text-anchor="middle"
                    dominant-baseline="central"
                  >
                    {c.n}
                  </text>
                  <text
                    x={c.side === "left" ? c.bx - R - 9 : c.bx + R + 9}
                    y={c.by}
                    class="hero-el__label"
                    text-anchor={c.side === "left" ? "end" : "start"}
                    dominant-baseline="central"
                  >
                    {c.label}
                  </text>
                </g>
              </g>
            ))
          }
        </g>
      </svg>

      {/*
        The overall dimension. In HTML rather than in the SVG so it stays real
        text at real token sizes on a 390px screen, where SVG text would have
        scaled down to nothing. The 45-degree slashes are the architect's
        terminator; nobody in this trade draws an arrowhead.
      */}
      <figcaption class="hero-el__dim">
        <span
          class="dim-rule dim-rule--start hero-el__dim-rule"
          aria-hidden="true"></span>
        <span class="hero-el__dim-text">{dimension}</span>
        <span
          class="dim-rule dim-rule--end hero-el__dim-rule"
          aria-hidden="true"></span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  /**
   * Draws the annotation once the figure is on screen. Ten lines, no library.
   *
   * The class is all this does; the stylesheet owns every duration, delay and
   * transform, so the whole effect retunes from tokens.css §8 and collapses to
   * nothing under prefers-reduced-motion without a second code path.
   */
  const fig = document.querySelector<HTMLElement>("[data-elevation]");

  if (fig && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add("is-drawn");
          io.unobserve(e.target);
        }
      },
      { rootMargin: "0px 0px -10% 0px" }
    );
    io.observe(fig);
  } else {
    // No observer: draw it immediately rather than leaving it hidden.
    fig?.classList.add("is-drawn");
  }
</script>

<style>
  .hero-el {
    padding-block: var(--space-xl) var(--section-y);
    /* The plan-sheet grid. Scoped to this one section on purpose: behind the
       whole page it would stop being a reference and start being wallpaper. */
    background-image:
      linear-gradient(
        to right,
        rgb(var(--color-overlay-scrim) / var(--grid-major-opacity)) var(--rule-dimension),
        transparent var(--rule-dimension)
      ),
      linear-gradient(
        to bottom,
        rgb(var(--color-overlay-scrim) / var(--grid-major-opacity)) var(--rule-dimension),
        transparent var(--rule-dimension)
      ),
      linear-gradient(
        to right,
        rgb(var(--color-overlay-scrim) / var(--grid-minor-opacity)) var(--rule-dimension),
        transparent var(--rule-dimension)
      ),
      linear-gradient(
        to bottom,
        rgb(var(--color-overlay-scrim) / var(--grid-minor-opacity)) var(--rule-dimension),
        transparent var(--rule-dimension)
      );
    background-size:
      var(--grid-major) var(--grid-major),
      var(--grid-major) var(--grid-major),
      var(--grid-minor) var(--grid-minor),
      var(--grid-minor) var(--grid-minor);
  }

  /* ---- the text block --------------------------------------------------- */

  .hero-el__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .hero-el__sheet {
    color: var(--color-accent);
  }

  .hero-el__heading {
    font-size: var(--step-5);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 20ch;
    text-wrap: balance;
  }

  .hero-el__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    padding-block-start: var(--space-s);
    border-block-start: var(--rule-dimension) solid var(--color-line-strong);
  }

  .hero-el__body {
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
    max-width: 44ch;
  }

  .hero-el__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
  }

  /* ---- the drawing ------------------------------------------------------ */

  .hero-el__figure {
    margin: var(--space-xl) 0 0;
  }

  .hero-el__svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    /* Matches the viewBox exactly, so nothing is cropped on a wide screen. */
    aspect-ratio: 1010 / 344;
    overflow: hidden;
  }

  /* Line weight IS meaning on a drawing: object heavier than dimension,
     dimension heavier than leader. That hierarchy is what replaces the drop
     shadows this build does not use. */
  .hero-el__ground {
    fill: none;
    stroke: var(--color-ink-strong);
    stroke-width: calc(var(--rule-object) + 1px);
  }

  .hero-el__roof {
    fill: none;
    stroke: var(--color-ink-strong);
    /* The heaviest line on the drawing after the ground. Wider than this and
       it stops reading as a rake edge and starts reading as a black slab. */
    stroke-width: 10;
    stroke-linejoin: miter;
  }

  .hero-el__field {
    stroke: var(--color-ink-strong);
    stroke-width: var(--rule-object);
  }

  .hero-el__opening {
    fill: var(--color-canvas);
    stroke: var(--color-ink-strong);
    stroke-width: var(--rule-object);
  }

  .hero-el__detail {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: var(--rule-dimension);
  }

  .hero-el__hatch {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: var(--rule-leader);
    opacity: 0.55;
  }

  .hero-el__stipple {
    fill: var(--color-ink);
    opacity: 0.28;
  }

  .hero-el__paper {
    fill: var(--color-canvas);
  }

  /* ---- annotation ------------------------------------------------------- */

  .hero-el__leader {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: var(--rule-leader);
  }

  .hero-el__tip {
    fill: var(--color-ink-strong);
  }

  .hero-el__bubble {
    fill: var(--color-canvas);
    stroke: var(--color-ink-strong);
    stroke-width: var(--rule-dimension);
  }

  .hero-el__num,
  .hero-el__label {
    font-family: var(--face-mono);
    font-weight: var(--weight-medium);
    fill: var(--color-ink-strong);
  }

  .hero-el__num {
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .hero-el__label {
    font-size: 15px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* ---- the overall dimension -------------------------------------------- */

  .hero-el__dim {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-m);
  }

  .hero-el__dim-text {
    font-family: var(--face-mono);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-indent: var(--tracking-wide);
    color: var(--color-accent);
    text-align: center;
  }

  /* ---- the signature moment ---------------------------------------------
     Start states are scoped to .js-motion, which motion.ts adds ONLY when it
     is alive and reduced motion is off. JS blocked, JS broken, or a
     vestibular preference set: everything below is already drawn. */

  :global(.js-motion) .hero-el__leader-g {
    transform: scaleX(0);
    transform-box: fill-box;
  }

  :global(.js-motion) .hero-el__leader-g--left {
    transform-origin: left center;
  }

  :global(.js-motion) .hero-el__leader-g--right {
    transform-origin: right center;
  }

  :global(.js-motion) .hero-el__bubble-g {
    opacity: 0;
  }

  :global(.js-motion) .hero-el__dim-rule {
    transform: scaleX(0);
  }

  :global(.js-motion) .hero-el__dim-rule.dim-rule--start {
    transform-origin: right center;
  }

  :global(.js-motion) .hero-el__dim-rule.dim-rule--end {
    transform-origin: left center;
  }

  :global(.js-motion) .hero-el__dim-text {
    opacity: 0;
  }

  :global(.js-motion) .hero-el__figure.is-drawn .hero-el__leader-g {
    transform: scaleX(1);
    transition: transform var(--sig-leader-duration) var(--sig-ease);
    transition-delay: calc(var(--i) * var(--sig-leader-stagger));
  }

  :global(.js-motion) .hero-el__figure.is-drawn .hero-el__bubble-g {
    opacity: 1;
    transition: opacity var(--duration-reveal) var(--ease-out);
    transition-delay: calc(
      var(--i) * var(--sig-leader-stagger) + var(--sig-leader-duration) * 0.45
    );
  }

  /* Beat two: the facade gets measured. Deliberately last — this line is the
     sentence the whole page is built on. */
  :global(.js-motion) .hero-el__figure.is-drawn .hero-el__dim-rule {
    transform: scaleX(1);
    transition: transform var(--sig-duration) var(--sig-ease);
    transition-delay: var(--sig-duration-long);
  }

  :global(.js-motion) .hero-el__figure.is-drawn .hero-el__dim-text {
    opacity: 1;
    transition: opacity var(--sig-duration) var(--ease-out);
    transition-delay: calc(var(--sig-duration-long) + 200ms);
  }

  /* ---- small screens -----------------------------------------------------
     The annotation margins cost roughly a third of the frame, and at 390px
     the labels inside them would render at about six pixels. So below the
     breakpoint the annotation goes and the house scales up into the space it
     leaves. Same drawing, same viewBox, one transform — not a second design.
     The dimension stays: it is the punchline, and it is HTML, so it stays
     legible at any width. */
  @media (max-width: 60em) {
    .hero-el__annot {
      display: none;
    }

    /* Narrower box + `slice` = the annotation margins crop away and the house
       fills the width. Chosen so roughly 600 viewBox units stay visible, which
       is the house plus a little air either side. */
    .hero-el__svg {
      aspect-ratio: 900 / 516;
    }
  }

  @media (min-width: 60em) {
    .hero-el__head {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      grid-template-areas:
        "sheet sheet"
        "heading intro";
      align-items: end;
      column-gap: var(--space-2xl);
    }

    .hero-el__sheet {
      grid-area: sheet;
    }
    .hero-el__heading {
      grid-area: heading;
    }
    .hero-el__intro {
      grid-area: intro;
    }
  }
</style>
