---
/**
 * HeroStamp — the hero for Approved Contractor, Inc. (differentiation log 005)
 *
 * REVISED. The first pass put a mounted photograph BESIDE a headline on a flat
 * red field. Right instincts, wrong proportions: the photograph was a
 * supporting element on a page selling a visual transformation, and a flat
 * full-bleed colour read as printed card. The house is now the hero, and the
 * red arrives as light laid OVER it — so the first thing anyone sees is the
 * actual work, and the brand colour still owns the screen.
 *
 * THE COPY IS THEIRS. The eyebrow and the H1 are verbatim from their homepage.
 * We are proposing a better setting of what they already say rather than
 * replacing their voice, and "A Home Exterior that Withstands the Test of Time"
 * is a genuinely good line that their current site sets in 24px Open Sans over
 * a manufacturer stock photo.
 *
 * THE FACT STRIP is where the argument starts: four checkable things, small and
 * dense, above the fold. The full record — and the stamp landing on it — is the
 * signature moment further down. This is the trailer for it.
 *
 * LCP. The photograph is the LCP element: eager, fetchpriority=high, sized.
 * The headline animates from a VISIBLE state via a CSS keyframe, never from
 * opacity 0, so first paint is complete with or without JS.
 */
import { Image } from "astro:assets";

interface Props {
  id?: string;
  eyebrow: string;
  heading: string;
  body: string;
  photo: ImageMetadata;
  photoAlt: string;
  /** Credit for the photograph — where, and what we did. */
  captionPlace: string;
  captionWork: string;
  ctaHref: string;
  ctaLabel: string;
  telHref: string;
  telLabel: string;
  /** The checkable strip across the foot. Four, never more. */
  facts: { value: string; label: string }[];
}

const {
  eyebrow,
  heading,
  body,
  photo,
  photoAlt,
  captionPlace,
  captionWork,
  ctaHref,
  ctaLabel,
  telHref,
  telLabel,
  facts,
  id = "top",
} = Astro.props;
---

<section id={id} class="hero on-brand" aria-labelledby="hero-heading">
  <div class="hero__media">
    <Image
      src={photo}
      alt={photoAlt}
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 class="hero__heading" id="hero-heading">{heading}</h1>
      <p class="hero__body">{body}</p>
      <div class="hero__actions">
        <a class="btn" href={ctaHref} data-magnetic>{ctaLabel}</a>
        <a class="btn btn--secondary" href={telHref}>{telLabel}</a>
      </div>
    </div>

    <p class="hero__caption">
      <span class="hero__caption-place record">{captionPlace}</span>
      <span class="hero__caption-work">{captionWork}</span>
    </p>
  </div>

  <ul class="hero__facts" role="list">
    {
      facts.map((f) => (
        <li class="hero__fact">
          <span class="hero__fact-value">{f.value}</span>
          <span class="hero__fact-label">{f.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    /* .on-brand supplies a background-color AND --grad-brand. Both must come
       off here or the photograph is invisible: `isolation: isolate` makes this
       element a stacking context, and a child at z-index -1 then paints BEHIND
       its own context's background rather than behind the page. The class is
       still needed for the token remapping (white ink, white focus ring), just
       not for its fill. */
    background-color: transparent;
    background-image: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    /* Measured against the concept badge, which is 172px tall and pinned to
       the viewport foot. At 29rem+26vh the fact strip landed at y=637 on an
       820px screen and the badge covered two of the four facts. This brings the
       strip up clear of it, and a shorter hero is the right call anyway — the
       services have to be visible on the first scroll, not the third. */
    min-block-size: clamp(24rem, 17rem + 24vh, 34rem);
    overflow: hidden;
  }

  /* ---- the photograph -------------------------------------------------- */

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* Their photos put the house in the upper two-thirds and driveway or lawn
       in the lower third, so anchoring high crops tarmac rather than roofline. */
    object-position: 50% 38%;
    filter: var(--image-filter-hero);
  }

  /* The brand arrives HERE — as light over the photograph rather than as a flat
     panel beside it. Two layers: the tinted gradient for colour, and a solid
     foot so the copy keeps its contrast regardless of what the photograph is
     doing underneath it. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background-image: var(--grad-photo);
  }

  /* A SIDE scrim as well as a bottom one. The bottom gradient alone left the
     eyebrow sitting on bright sky at the top of the copy column — white on a
     pale roofline, which fails AA outright. A left-anchored wedge gives the
     whole copy column a ground regardless of how tall the headline runs, and
     releases before the middle of the frame so the house stays lit. */
  .hero__scrim::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to right,
      rgb(35 31 32 / 0.78) 0%,
      rgb(35 31 32 / 0.52) 26%,
      rgb(35 31 32 / 0.12) 52%,
      rgb(35 31 32 / 0) 68%
    );
  }

  .hero__scrim::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    /* Tuned by eye against the real photograph. The first draft stacked 0.88
       on top of --grad-photo's 0.82 and composited to ~0.98 at the foot, which
       crushed the house into a flat red panel — the exact failure this hero
       exists to avoid. The copy sits in the lower left, so the scrim is
       strongest there and releases fast. */
    block-size: 72%;
    background-image: linear-gradient(
      to top,
      rgb(35 31 32 / 0.72) 0%,
      rgb(35 31 32 / 0.34) 46%,
      rgb(35 31 32 / 0) 100%
    );
  }

  /* ---- copy ------------------------------------------------------------ */

  .hero__inner {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    max-inline-size: var(--container-xl);
    margin-inline: auto;
    padding-inline: var(--gutter);
    /* Tightened from --space-xl/--space-m. The hero's height is content-driven,
       not min-height-driven, so trimming the padding is the only lever that
       actually lifts the fact strip clear of the badge's reserved corner. */
    padding-block: var(--space-l) var(--space-s);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-m);
  }

  /* 38rem, measured rather than guessed. The two CTAs come to 558px together
     (317 + 229 + the gap) and a 46ch column gave them 508 — so they stacked,
     which in a hero reads as indecision. Widening the COLUMN rather than
     shrinking the buttons also drops the headline from three lines to two,
     which is the right answer for a page meant to be scanned.

     The body paragraph keeps its own narrower measure below, so the column
     being wide does not make the prose hard to read. */
  .hero__copy {
    max-inline-size: 38rem;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2xs);
    font-family: var(--face-body);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: #ffffff;
    text-shadow: 0 1px 3px rgb(35 31 32 / 0.6);
  }

  .hero__heading {
    margin: 0;
    font-size: var(--step-6);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: #ffffff;
    text-wrap: balance;
    text-shadow: 0 2px 12px rgb(35 31 32 / 0.5);
  }

  .hero__body {
    margin: var(--space-s) 0 0;
    max-inline-size: 46ch;
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: #ffffff;
    text-shadow: 0 1px 6px rgb(35 31 32 / 0.6);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }

  .hero__actions .btn {
    white-space: nowrap;
  }

  /* The photograph's own credit. Small, bottom-right, so the image is
     identified as a real job rather than passing as stock. */
  .hero__caption {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    text-align: end;
    color: #ffffff;
    text-shadow: 0 1px 4px rgb(35 31 32 / 0.7);
  }

  .hero__caption-place {
    color: #ffffff;
    text-indent: 0;
    opacity: 0.85;
  }

  .hero__caption-work {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
  }

  /* ---- the fact strip -------------------------------------------------- */

  .hero__facts {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    background-color: rgb(255 255 255 / 0.22);
    border-block-start: 1px solid rgb(255 255 255 / 0.22);
  }

  @media (min-width: 46em) {
    .hero__facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .hero__fact {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: var(--space-xs) var(--gutter);
    background-image: var(--grad-brand-deep);
  }

  .hero__fact-value {
    font-family: var(--face-display);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    line-height: 1.1;
    color: #ffffff;
  }

  .hero__fact-label {
    font-size: var(--step--1);
    line-height: var(--leading-snug);
    color: var(--b-100);
  }

  /* ---- first paint ----------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow,
    .hero__heading,
    .hero__body,
    .hero__actions {
      animation: hero-settle var(--duration-hero) var(--ease-out) backwards;
    }
    .hero__heading {
      animation-delay: calc(var(--motion-hero-delay) * 1);
    }
    .hero__body {
      animation-delay: calc(var(--motion-hero-delay) * 1.8);
    }
    .hero__actions {
      animation-delay: calc(var(--motion-hero-delay) * 2.4);
    }
  }

  @keyframes hero-settle {
    from {
      opacity: 1;
      transform: translateY(var(--motion-distance-s));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 46em) {
    .hero {
      min-block-size: clamp(22rem, 17rem + 26vh, 29rem);
    }

    .hero__inner {
      padding-block: var(--space-l) var(--space-s);
    }

    /* Provenance, not persuasion — the space belongs to the headline. */
    .hero__caption {
      display: none;
    }

    /* The full-width sticky call bar is an exact duplicate of this. */
    .hero__actions .btn--secondary {
      display: none;
    }
  }
</style>
