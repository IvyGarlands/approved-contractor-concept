---
/**
 * CredentialLedger — every other approval, after the one on the record card.
 *
 * REPLACES the badge wall. Their homepage runs eleven partner and award logos
 * in a row, which is the default answer in this trade and reads as desperate:
 * eleven marks of unequal weight, all shouting at once, none of them explained.
 *
 * Two separate reasons this is typographic instead:
 *
 *   1. LEGAL. The James Hardie, Andersen, Pella, Anlin and Owens Corning marks
 *      are licensed to the BUSINESS for its own advertising, not to us for a
 *      concept hosted on our domain (input/facts.txt §6). Re-hosting them is
 *      not ours to do. Set in type, a credential is a statement of fact about
 *      who granted what, which is fine.
 *
 *   2. EDITORIAL. It is the better page anyway. Grouped by WHO granted it and
 *      glossed with what it actually means, the same eleven facts stop being a
 *      wall and become a ledger — which is the argument this whole page is
 *      making. One of them is set at scale; the rest are quiet. James Hardie
 *      Elite is a genuinely selective designation in this trade and deserves
 *      the weight; a Houzz badge from 2018 does not.
 *
 * HONESTY. `meaning` is a factual gloss, never a sales line, and where a
 * credential could not be independently verified it says so in the row rather
 * than in a footnote nobody reads. The BBB row in particular states that the
 * A+ rating comes with "not accredited", because that is what the BBB profile
 * actually says and the client's own site's "BBB A+ rating" is accurate only
 * as far as it goes.
 */
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";
import type { CollectionEntry } from "astro:content";
import type { SectionProps } from "./Section.astro";

interface Props extends SectionProps {
  eyebrow?: string;
  heading: string;
  body?: string;
  items: CollectionEntry<"credentials">[];
  /** The one set at scale. Matched against `label`. */
  featureLabel?: string;
  footnote?: string;
}

const {
  eyebrow,
  heading,
  body,
  items,
  featureLabel,
  footnote,
  id = "credentials",
  tone,
  spacing,
  ...rest
} = Astro.props;

const sorted = [...items].sort((a, b) => a.data.order - b.data.order);
const feature = featureLabel
  ? sorted.find((i) => i.data.label === featureLabel)
  : undefined;
const rest_ = sorted.filter((i) => i !== feature);

// Group order follows the order the items were authored in, so the ledger
// reads state → manufacturer → trade without a second sort key.
const groups: { name: string; items: typeof rest_ }[] = [];
for (const item of rest_) {
  const name = item.data.group ?? "";
  const existing = groups.find((g) => g.name === name);
  if (existing) existing.items.push(item);
  else groups.push({ name, items: [item] });
}
---

<Section
  id={id}
  tone={tone}
  spacing={spacing}
  width="l"
  labelledBy={`${id}-heading`}
  {...rest}
>
  <SectionHeader
    eyebrow={eyebrow}
    heading={heading}
    body={body}
    headingId={`${id}-heading`}
  />

  {
    feature && (
      <div class="led__feature" data-reveal>
        <p class="led__feature-label">{feature.data.label}</p>
        {feature.data.meaning && (
          <p class="led__feature-meaning">{feature.data.meaning}</p>
        )}
        <p class="led__feature-issuer record">
          {feature.data.issuer}
          {feature.data.verifyUrl && (
            <>
              {" · "}
              <a href={feature.data.verifyUrl} rel="noopener" target="_blank">
                Check it
              </a>
            </>
          )}
        </p>
      </div>
    )
  }

  <div class="led">
    {
      groups.map((g) => (
        <section class="led__group" data-reveal-stagger>
          {g.name && <h3 class="led__group-name record">{g.name}</h3>}
          <ul class="led__list" role="list">
            {g.items.map((item) => (
              <li class="led__row" data-reveal="fade">
                <p class="led__label">{item.data.label}</p>
                {item.data.meaning && (
                  <p class="led__meaning">{item.data.meaning}</p>
                )}
                {item.data.verifyUrl && (
                  <a
                    class="led__verify"
                    href={item.data.verifyUrl}
                    rel="noopener"
                    target="_blank"
                  >
                    Check it
                  </a>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  {footnote && <p class="led__footnote">{footnote}</p>}
</Section>

<style>
  /* ---- the one that gets the weight ------------------------------------ */

  .led__feature {
    margin-block: var(--space-l) var(--space-xl);
    padding-block-end: var(--space-m);
    border-block-end: var(--border-rule) solid var(--color-brand);
  }

  .led__feature-label {
    margin: 0;
    font-family: var(--face-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-display);
    color: var(--color-ink-strong);
    text-wrap: balance;
  }

  .led__feature-meaning {
    margin: var(--space-s) 0 0;
    max-inline-size: var(--measure);
    font-size: var(--step-1);
    line-height: var(--leading-snug);
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .led__feature-issuer {
    margin: var(--space-m) 0 0;
    color: var(--color-accent);
    text-indent: 0;
  }

  .led__feature-issuer a {
    /* §5 touch target — this one sits inside a <p>, so it needs the same
       inline-flex + min-height treatment as .led__verify. */
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: var(--color-brand);
  }

  /* ---- the ledger ------------------------------------------------------ */

  /* MULTICOL, NOT GRID.
     A two-column grid put each GROUP in a cell, and the groups are wildly
     uneven — "The state" holds one credential, "The manufacturers" five,
     "The trade" four. Grid rows size to their tallest cell, so the one-item
     group left roughly 400px of dead canvas beside it and the whole section
     read as broken.

     Multicol flows the content instead of placing it, so the columns balance
     themselves whatever the group sizes are. Rows never split across a column
     break, and a group heading never gets stranded at the foot of one. */
  .led {
    margin-block-start: var(--space-l);
  }

  @media (min-width: 52em) {
    .led {
      columns: 2;
      column-gap: var(--space-2xl);
    }
  }

  .led__group {
    break-inside: auto;
  }

  .led__group + .led__group {
    margin-block-start: var(--space-l);
  }

  .led__row {
    break-inside: avoid;
  }

  .led__group-name {
    break-after: avoid;
    margin: 0 0 var(--space-xs);
    padding-block-end: var(--space-2xs);
    border-block-end: var(--border-hair) solid var(--color-line-strong);
    font-family: var(--face-body);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--color-accent);
    text-indent: 0;
  }

  .led__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .led__row {
    padding-block: var(--space-s);
    border-block-end: var(--border-hair) solid var(--color-line);
  }

  .led__label {
    margin: 0;
    font-family: var(--face-display);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    color: var(--color-ink-strong);
  }

  .led__meaning {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step-0);
    line-height: var(--leading-snug);
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }

  .led__verify {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem; /* §5 touch target */
    margin-block-start: var(--space-3xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    letter-spacing: var(--tracking-control);
    color: var(--color-brand);
    text-underline-offset: 0.22em;
  }

  .led__footnote {
    margin-block-start: var(--space-xl);
    max-inline-size: var(--measure);
    font-size: var(--step--1);
    line-height: var(--leading-body);
    color: var(--color-ink-muted);
    text-wrap: pretty;
  }
</style>
