---
/**
 * CredentialSchedule — credentials as a drawing's SCHEDULE.
 *
 * Every plan set has schedules: the window schedule, the door schedule, the
 * finish schedule. A schedule is a ruled two-column table where the left
 * column names the thing and the right column says where it comes from. That
 * is exactly the shape of a credential, so this is what the trust band on this
 * site is — not a row of green ticks.
 *
 * WHY NOT THE ENGINE'S TrustBar. Two reasons, both real. Structurally it
 * centres a wrapping flex row, which with seven items of very different label
 * lengths ("Pella Windows partner" against "Contractors State License Board")
 * ragged itself into three-line columns. And visually a row of ticks is the
 * single most generic device in this vertical — every exterior contractor in
 * the Valley has one, which makes it worth exactly nothing as a trust signal.
 *
 * EVERY ITEM IS CLIENT-SUPPLIED, VERBATIM (CLAUDE.md §11). We never originate
 * a licence number, a certification or an award. If the collection is empty
 * the section does not render — an empty credentials band is fine, an invented
 * one is a legal problem.
 */
import Section from "./Section.astro";
import type { CollectionEntry } from "astro:content";
import type { SectionProps } from "./Section.astro";

interface Props extends SectionProps {
  items: CollectionEntry<"credentials">[];
  /** The schedule's title, e.g. "Certified, listed and licensed". */
  label: string;
}

const {
  items,
  label,
  id = "credentials",
  tone = "sunken",
  spacing = "tight",
  ...rest
} = Astro.props;

/**
 * Rows per column, so the two columns read top-to-bottom rather than
 * interleaving across the gap. Seven items become 4 + 3.
 */
const rows = Math.ceil(items.length / 2);
---

{
  items.length > 0 && (
    <Section
      id={id}
      tone={tone}
      spacing={spacing}
      width="xl"
      aria-label={label}
      {...rest}
    >
      <div class="cred" data-reveal-stagger>
        <p class="annot cred__label" data-reveal>
          {label}
        </p>

        <dl class="cred__schedule" style={`--rows:${rows}`} data-reveal>
          {items.map((item) => (
            <div class="cred__row">
              <dt class="cred__name">{item.data.label}</dt>
              {/* No issuer renders an EMPTY cell, not an em-dash. A schedule
                  uses "—" to mean "deliberately none", which is not what an
                  absent issuer means here — three of these credentials name
                  their issuer inside the label already. */}
              <dd class="cred__issuer annot">{item.data.issuer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </Section>
  )
}

<style>
  .cred {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }

  .cred__label {
    color: var(--color-accent);
  }

  .cred__schedule {
    margin: 0;
    border-block-start: var(--rule-object) solid var(--color-ink-strong);
  }

  .cred__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s);
    border-block-end: var(--rule-dimension) solid var(--color-line-strong);
  }

  .cred__name {
    font-family: var(--face-display);
    font-stretch: var(--face-display-stretch, 100%);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink-strong);
  }

  .cred__issuer {
    margin: 0;
    text-align: end;
    color: var(--color-ink-muted);
  }

  /* Two columns, filled DOWN each one — column-major flow, so the schedule
     reads 1-2-3-4 then 5-6-7 instead of zig-zagging across the gutter. */
  @media (min-width: 60em) {
    .cred__schedule {
      display: grid;
      grid-auto-flow: column;
      grid-template-rows: repeat(var(--rows), auto);
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-3xl);
    }

    /* Grid rows are shared across both columns, so a two-line cell on the
       right makes that row taller than the one-line cell on the left. Without
       this the short cell's rule stops under its own text and the two columns
       stop lining up — which on a ruled schedule is the one thing you notice. */
    .cred__row {
      block-size: 100%;
    }
  }
</style>
