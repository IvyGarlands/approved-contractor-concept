---
/**
 * TitleBlock — the panel in the corner of every plan sheet.
 *
 * On a real drawing set the title block is the ruled box that holds who drew
 * it, where the job is, and the stamp. It is the sheet's identity, and it is
 * the one place on a drawing where facts are stated flatly instead of drawn.
 *
 * So it is the right home for everything this business can prove: the mark,
 * the licence, the address, the counties they will actually drive to, and the
 * figures. Nothing in here is styled to persuade — it is a table, ruled in
 * hairlines, and the persuasion is that it reads like a document.
 *
 * EVERY VALUE ARRIVES AS A PROP FROM THE PAGE, which reads them from
 * site.ts and the intake. Nothing is hardcoded here, and nothing that the
 * operator did not supply gets a cell (CLAUDE.md §3, §11).
 */
import Section from "./Section.astro";
import StampMark from "../core/StampMark.astro";
import { SITE } from "../../config/site";
import type { SectionProps } from "./Section.astro";

interface Props extends SectionProps {
  /** Column heads. Mono, tracked, the way a title block labels its fields. */
  areasLabel: string;
  areas: string[];
  figuresLabel: string;
  figures: { value: string; label: string }[];
  termsLabel: string;
  terms: string[];
  /** Accessible name for the landmark — this section has no visible heading. */
  label: string;
}

const {
  areasLabel,
  areas,
  figuresLabel,
  figures,
  termsLabel,
  terms,
  label,
  id = "record",
  tone = "dark",
  spacing = "default",
  ...rest
} = Astro.props;
---

<Section
  id={id}
  tone={tone}
  spacing={spacing}
  width="xl"
  aria-label={label}
  {...rest}
>
  <div class="tb" data-reveal-stagger>
    {/* Field 1 — the sheet's identity. */}
    <div class="tb__cell tb__cell--mark" data-reveal>
      <StampMark size="lg" serial />

      <address class="tb__address">
        {SITE.address.street}<br />
        {SITE.address.locality}, {SITE.address.region} {SITE.address.postalCode}
      </address>

      <a class="tb__phone" href={`tel:${SITE.phoneHref}`}>{SITE.phone}</a>
    </div>

    {/* Field 2 — where the trucks go. Indexed, because a title block indexes. */}
    <div class="tb__cell" data-reveal>
      <p class="annot tb__label">{areasLabel}</p>
      <ol class="tb__areas" role="list">
        {
          areas.map((area, i) => (
            <li class="tb__area">
              <span class="tb__area-n" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span>{area}</span>
            </li>
          ))
        }
      </ol>
    </div>

    {/* Field 3 — the figures, set in mono so they align as a column. */}
    <div class="tb__cell" data-reveal>
      <p class="annot tb__label">{figuresLabel}</p>
      <dl class="tb__figures">
        {
          figures.map((f) => (
            <div class="tb__figure">
              <dt class="tb__figure-value">{f.value}</dt>
              <dd class="tb__figure-label">{f.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    {/* Field 4 — terms. */}
    <div class="tb__cell" data-reveal>
      <p class="annot tb__label">{termsLabel}</p>
      <ul class="tb__terms" role="list">
        {terms.map((term) => <li class="tb__term">{term}</li>)}
      </ul>
    </div>
  </div>
</Section>

<style>
  /* Ruled like a title block: one outer frame, hairlines between fields. The
     gap-plus-outline trick draws every internal rule without a single border
     declaration that has to know which cell it is on. */
  .tb {
    display: grid;
    gap: var(--rule-dimension);
    background-color: var(--color-line-strong);
    border: var(--rule-object) solid var(--color-line-strong);
  }

  .tb__cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    padding: var(--space-l);
    background-color: var(--color-canvas);
  }

  .tb__cell--mark {
    gap: var(--space-m);
  }

  .tb__label {
    color: var(--color-ink-muted);
  }

  .tb__address {
    color: var(--color-ink-muted);
    line-height: var(--leading-snug);
  }

  .tb__phone {
    font-family: var(--face-display);
    font-stretch: var(--face-display-stretch, 100%);
    font-size: var(--step-2);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-heading);
    color: var(--color-ink-strong);
    text-decoration: none;
  }

  .tb__phone:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  /* ---- areas ------------------------------------------------------------ */

  .tb__areas {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
  }

  .tb__area {
    display: flex;
    gap: var(--space-s);
    align-items: baseline;
    line-height: var(--leading-snug);
  }

  .tb__area-n {
    font-family: var(--face-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
  }

  /* ---- figures ---------------------------------------------------------- */

  .tb__figures {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin: 0;
  }

  .tb__figure-value {
    font-family: var(--face-mono);
    font-size: var(--step-2);
    font-weight: var(--weight-strong);
    line-height: 1;
    color: var(--color-ink-strong);
    /* Tabular figures so the three values line up on their own left edge. */
    font-variant-numeric: tabular-nums;
  }

  .tb__figure-label {
    margin: var(--space-3xs) 0 0;
    font-size: var(--step--1);
    color: var(--color-ink-muted);
  }

  /* ---- terms ------------------------------------------------------------ */

  .tb__terms {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
  }

  .tb__term {
    line-height: var(--leading-snug);
    color: var(--color-ink);
  }

  @media (min-width: 46em) {
    .tb {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72em) {
    .tb {
      grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
    }
  }
</style>
