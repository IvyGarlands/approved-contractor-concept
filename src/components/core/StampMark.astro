---
/**
 * StampMark — the wordmark for Approved Contractor, Inc.
 *
 * THIS IS A REDRAW, NOT A REPLACEMENT. Their existing mark is a good idea with
 * poor execution, and the brief on that is unambiguous: keep the recognisable
 * shape, the era, the ornament and the color; fix the spacing, the curves, the
 * weight and the legibility at small sizes. See input/brand.md §7.
 *
 * WHAT THE ORIGINAL IS (sampled, not guessed — input/brand.md §1–2):
 *   - "APPROVED" in heavy roman capitals, inside a rounded-rectangle DOUBLE
 *     rule, rotated roughly −6°, printed in #ae0f15.
 *   - "Contractor" BELOW and to the right, horizontal, in a light geometric
 *     sans with generous letterspacing, in #231f20.
 *   - The contrast between those two genres is the whole idea of the mark: a
 *     bureaucratic rubber stamp landing on a calm modern name.
 *
 * WHAT IS KEPT: all of the above. Both colours are the client's own sampled
 * hex values, unchanged. The lockup, the rotation, the double rule, the case,
 * the two-genre contrast and the relative position of the two words are all
 * theirs.
 *
 *   NOTE: build 003 set "Contractor" BESIDE the frame rather than beneath it,
 *   which quietly broke the lockup. It is back where they have it.
 *
 * WHAT IS FIXED:
 *   1. VECTOR, NOT A 590px RASTER. The original is a bitmap; this sets at any
 *      size, including --step-7 in the signature moment.
 *   2. THE DISTRESS TEXTURE IS GONE. 26,406 of the original's 37,356
 *      non-transparent pixels are partial-alpha mottling — stock "grunge stamp"
 *      filtering, and the single thing that makes it read as clip-art. The mark
 *      now gets its character from letterform, weight and frame proportion. A
 *      stamp that is drawn rather than filtered.
 *   3. ONE ROTATION. The original's angle differs between the header and
 *      footer copies because it is an accident of the source graphic. Here it
 *      is --stamp-angle, one token, shared with every other stamp on the page.
 *   4. RE-SPACED. In the original, "Contractor" collides with the frame's lower
 *      rule and the two words' optical centers disagree.
 *   5. LEGIBLE AT 24px, which the distressed original is not.
 *   6. ONE RED. Their logo uses #ae0f15 and their stylesheet uses #aa0e00;
 *      this uses --color-brand, which is #ae0f15 everywhere.
 *
 * COMPLIANCE — read before changing anything (CLAUDE.md §11, contractor).
 * A stamp device in a licensed trade must not imply MUNICIPAL approval. This
 * mark contains only the business's own name and, where `serial` is set, its
 * own CSLB number. It must never gain the words permit, city, county,
 * inspected, certified or "approved by", and never a seal, a scallop, an eagle
 * or a date field. It is a wordmark in a stamp frame. Keep it that way.
 *
 * Color comes from --color-brand / --color-ink-strong, so the mark re-inks
 * itself in .on-dark and .on-brand with no variant prop.
 */
import { SITE } from "../../config/site";

interface Props {
  /** sm = header, md = footer, lg = the record section (once per page). */
  size?: "sm" | "md" | "lg";
  /** Show the CSLB serial line. Only where there is room to read it. */
  serial?: boolean;
  class?: string;
}

const { size = "sm", serial = false, class: className } = Astro.props;
---

<span class:list={["stamp", `stamp--${size}`, className]}>
  <span class="stamp__frame">
    <span class="stamp__word">Approved</span>
  </span>
  <span class="stamp__rest">Contractor{size === "lg" ? ", Inc." : ""}</span>
  {
    serial && SITE.licenseNumber && (
      <span class="stamp__serial record">{SITE.licenseNumber}</span>
    )
  }
</span>

<style>
  .stamp {
    display: inline-grid;
    justify-items: start;
    line-height: 1;
    /* The frame is rotated, so the lockup needs room on the block axis or the
       stamp's corners clip against whatever sits above and below it. */
    padding-block: 0.28em;
  }

  /* The frame. A heavy rule with a lighter one shadowing it at a gap, which is
     how an inked double-rule stamp actually prints — the die edge, then the
     bleed. Built from border + outline rather than two elements so there is
     nothing to keep in sync, and rounded because their frame is rounded. */
  .stamp__frame {
    display: inline-flex;
    align-items: center;
    padding: var(--stamp-inset);
    border: var(--stamp-border) solid var(--color-brand);
    border-radius: var(--stamp-radius);
    outline: var(--stamp-border-inner) solid var(--color-brand);
    outline-offset: var(--stamp-gap);
    color: var(--color-brand);
    transform: rotate(var(--stamp-angle));
    transform-origin: 40% 60%;

    font-family: var(--face-display);
    font-weight: var(--weight-stamp);
    font-size: 1em;
    text-transform: uppercase;
    letter-spacing: var(--tracking-stamp);
  }

  .stamp__word {
    /* Tracking adds a trailing space after the final glyph; put it back on the
       left or the word sits visibly off-center inside the frame. */
    text-indent: var(--tracking-stamp);
  }

  /* "Contractor": horizontal while the stamp is not, indented so it starts
     under the middle of the frame, and pulled up so the stamp reads as having
     landed ON the name rather than floating above it. Exactly the relationship
     in their original. */
  .stamp__rest {
    margin-block-start: 0.18em;
    margin-inline-start: 1.15em;
    font-family: var(--face-body);
    font-weight: var(--weight-light);
    font-size: 0.92em;
    letter-spacing: 0.13em;
    text-indent: 0.13em;
    color: var(--color-ink-strong);
  }

  .stamp__serial {
    margin-block-start: 0.5em;
    margin-inline-start: 1.2em;
    font-size: 0.5em;
  }

  /* ---- sizes ----------------------------------------------------------
     Sized in em off a single font-size so every part scales together. */

  .stamp--sm {
    font-size: clamp(0.9375rem, 0.88rem + 0.28vw, 1.125rem);
  }

  .stamp--md {
    font-size: var(--step-1);
  }

  /* The one-per-page appearance. */
  .stamp--lg {
    font-size: var(--step-3);
  }

  /* At the smallest size the outline ring is the first thing to become mush,
     so it is dropped below ~15px and the frame carries the mark alone. This is
     the legibility fix the raster original cannot make. */
  @media (max-width: 26em) {
    .stamp--sm .stamp__frame {
      outline: 0;
    }
  }
</style>
