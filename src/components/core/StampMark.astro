---
/**
 * StampMark — the wordmark for Approved Contractor, Inc.
 *
 * THE IDEA. In construction, APPROVED is the word a plan check puts on
 * drawings that pass. This business is called Approved Contractor and nobody
 * had ever drawn the name as what it already is. So the mark is a stamp: the
 * word APPROVED inside a double-ruled frame, printed in plan-check red, with
 * the rest of the name set beside or beneath it.
 *
 * COMPLIANCE — read before changing anything here (CLAUDE.md §11, contractor).
 * A stamp device in a licensed trade must not imply MUNICIPAL approval. This
 * mark therefore contains only the business's own name and, at `lg`, its own
 * CSLB number. It must never gain the words permit, city, county, inspected,
 * certified, or "approved by", and it must never gain a seal, a scallop, an
 * eagle or a date field. It is a wordmark in a stamp frame. Keep it that way.
 *
 * Colour comes from --color-accent, so the mark re-inks itself automatically
 * in .on-dark and .on-brand contexts without a variant prop.
 */
import { SITE } from "../../config/site";

interface Props {
  /** sm = header, md = footer, lg = the title block (once per page). */
  size?: "sm" | "md" | "lg";
  /** Show the CSLB serial line. Only true where there is room to read it. */
  serial?: boolean;
  class?: string;
}

const { size = "sm", serial = false, class: className } = Astro.props;
---

<span class:list={["stamp", `stamp--${size}`, className]}>
  <span class="stamp__frame">
    <span class="stamp__word">Approved</span>
  </span>
  <span class="stamp__rest">Contractor{size === "lg" ? ", Inc." : ""}</span>
  {
    serial && SITE.licenseNumber && (
      <span class="stamp__serial">{SITE.licenseNumber}</span>
    )
  }
</span>

<style>
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--face-display);
    font-stretch: var(--face-display-stretch, 100%);
    font-weight: var(--weight-display);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-ink-strong);
    /* Tracking leaves a trailing space on the final glyph of every run. */
    text-indent: 0;
  }

  /* The frame: a heavy rule with a hairline shadowing it, which is how an
     inked stamp actually prints — the die edge and the ink bleed. Built from
     border + outline rather than two elements so there is nothing to keep in
     sync. */
  .stamp__frame {
    display: inline-flex;
    align-items: center;
    padding: var(--stamp-inset);
    border: var(--stamp-border) solid var(--color-accent);
    outline: var(--border-hair) solid var(--color-accent);
    outline-offset: var(--stamp-gap);
    color: var(--color-accent);
  }

  .stamp__word {
    /* The tracked-out run needs its trailing space put back on the left or the
       word sits visibly off-centre inside the frame. */
    text-indent: var(--tracking-label);
  }

  .stamp__rest {
    color: var(--color-ink-strong);
  }

  .stamp__serial {
    font-family: var(--face-mono);
    font-size: 0.62em;
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-muted);
    text-indent: var(--tracking-wide);
  }

  /* ---- sizes ---------------------------------------------------------- */

  .stamp--sm {
    font-size: var(--step--1);
  }

  .stamp--md {
    font-size: var(--step-0);
  }

  /* The one-per-page appearance. Stacks, so the frame reads as a stamp that
     has landed on the sheet rather than as a button in a row of words. */
  .stamp--lg {
    display: inline-grid;
    justify-items: start;
    gap: 0.5em;
    font-size: var(--step-2);
  }

  .stamp--lg .stamp__rest {
    font-size: 0.82em;
    letter-spacing: var(--tracking-label);
  }

  /* The stamp frame is the single densest use of the accent on the page, so
     it holds its own margin at every size rather than inheriting a gap. */
  .stamp--lg .stamp__frame {
    padding: 0.55em 0.9em;
  }
</style>
