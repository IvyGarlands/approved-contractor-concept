---
/**
 * /contact — the address on the licence, the number on the licence, and a form.
 *
 * `showHours` is false and stays false: they publish no hours anywhere, and
 * third-party listings disagree with each other on Saturday. Inventing
 * "Mon-Fri 8-5" for a contractor is exactly the small invented fact that leaves
 * a homeowner standing outside a locked unit (input/facts.txt §3).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import LocationContact from "../components/sections/LocationContact.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import AreasServed from "../components/sections/AreasServed.astro";
import FAQ from "../components/sections/FAQ.astro";
import CTABand from "../components/sections/CTABand.astro";
import PhotoBand from "../components/sections/PhotoBand.astro";
import Divider from "../components/core/Divider.astro";

import heroPhoto from "../assets/photos/la-newbuild-03.jpg";

/* Five real jobs, edge to edge, to keep the product in front of someone on a
   page that is otherwise records and lists. See PhotoBand for why alt is "". */
import bandA from "../assets/photos/rpv-03.jpg";
import bandB from "../assets/photos/la-stucco-to-hardie-after.jpg";
import bandC from "../assets/photos/thousand-oaks-08.jpg";
import bandD from "../assets/photos/la-newbuild-01.jpg";
import bandE from "../assets/photos/encino-01.jpg";

import { SITE, LICENCE } from "../config/site";
import { localized } from "../lib/content";
import { useTranslations, localeFromUrl } from "../i18n/ui";
import { NAV_LINKS, CALL_HREF, COUNTIES, CITIES } from "../lib/page";

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const callLabel = `${t("cta.call")} ${SITE.phone}`;

const process = await localized("process", locale);
const faqs = await localized("faq", locale);
const faqSchema = faqs.map((f) => ({
  question: f.data.question,
  answer: f.data.answer,
}));

const bandPhotos = [
  { src: bandA, label: "Rancho Palos Verdes, CA" },
  { src: bandB, label: "Los Angeles, CA" },
  { src: bandC, label: "Thousand Oaks, CA" },
  { src: bandD, label: "Los Angeles, CA" },
  { src: bandE, label: "Encino, CA" },
];
---

<BaseLayout
  title="Contact us today for a free quote"
  description="Approved Contractor, Inc. — 9015 Eton Avenue, Unit D, Canoga Park, CA 91304. Call (877) 792-9082 for a free exterior consultation. CSLB #952272."
  path="/contact"
  navLinks={NAV_LINKS}
  faq={faqSchema}
>
  <PageHero
    eyebrow="Contact us"
    heading="Get a free quote on the outside of your house."
    body="Tell us what's bothering you about the exterior and we'll tell you what's actually failing. No aggressive sales, and no upsell on things you don't need."
    photo={heroPhoto}
    photoAlt="A modern two-storey Los Angeles home finished in James Hardie lap siding."
    crumbs={[{ label: "Home", href: "/" }]}
  />

  <LocationContact
    id="contact"
    locale={locale}
    eyebrow="Canoga Park"
    heading="Where our trucks go out from."
    body="9015 Eton Avenue — the address on our licence, not a mailbox."
    showHours={false}
    formSubject="Exterior consultation request"
    spacing="default"
  />

  <Divider tone="sunken" />

  <ProcessSteps
    id="process"
    eyebrow="What happens when you call"
    heading="Four steps, and you can stop after any of them."
    steps={process}
    layout="row"
    tone="sunken"
    spacing="default"
  />

  <PhotoBand photos={bandPhotos} caption="Recent work across Los Angeles, Ventura and San Diego counties" />

  <AreasServed
    id="areas"
    eyebrow="Areas we serve"
    heading="Do we come out to you?"
    counties={COUNTIES}
    cities={CITIES}
    note="If your town isn't on this list, call and ask. The honest answer is either yes or no."
    spacing="default"
  />

  <FAQ
    id="faq"
    locale={locale}
    eyebrow="Before you call"
    heading="The questions people actually ask."
    items={faqs}
    tone="sunken"
    spacing="default"
  />

  <CTABand
    heading="Or just pick up the phone."
    body="We answer your calls and we email you back. That shouldn't be a differentiator in this trade, but it is."
    ctaLabel={callLabel}
    ctaHref={CALL_HREF}
    secondaryLabel="Check our licence"
    secondaryHref={LICENCE.lookupUrl}
    note="CA Lic. #952272 · Class B · Current and active · Free consultations"
    align="split"
    tone="brand"
    class="on-brand--deep"
    spacing="tight"
  />
</BaseLayout>
