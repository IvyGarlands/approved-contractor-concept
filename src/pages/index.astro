---
/**
 * Homepage — Approved Contractor, Inc. (concept build 005, "The Stamp").
 *
 * THE ONE-SENTENCE IDEA
 * ---------------------
 * Every contractor in California says they're approved. We're the one you can
 * go and check — so the page is built as the record you check us against, and
 * our own stamp is what lands on it.
 *
 * SECTION ORDER, AND WHY IT CHANGED
 * ----------------------------------
 * The first pass ran the license record second, on the argument that the proof
 * IS the sell. That was backwards. Nobody arrives at a contractor's site
 * wanting to read a license — they arrive wanting to know whether we do the
 * thing their house needs, and what it looks like when we've done it. Proof
 * answers the second question they ask, not the first.
 *
 *   1  HERO          a real finished job, full-bleed, with their own headline
 *   2  WHAT WE DO    six trades, each with a photograph of it finished
 *   3  THE WORK      before and after, then five more jobs
 *   4  THE RECORD    the signature moment. The license, and the stamp
 *   5  CREDENTIALS   everyone else who has checked us
 *   6  PROCESS       what happens when you call, in their own words
 *   7  PROMISE       their "Our Promise To You", set properly
 *   8  REVIEWS       one at length, then eight short
 *   9  WHO WE ARE    the owner. LAST of the persuasion, not second
 *  10  FAQ / CONTACT / CLOSE
 *
 * VOICE. First person throughout — "we", "our", "us". The copy is the client's
 * own wherever they wrote something usable, which is most places: the hero
 * headline and eyebrow, all six service summaries, all four process steps and
 * every line of the promise list are verbatim from their site. Where we wrote
 * new copy it is a proposal in their voice, replaced by their own words the
 * moment they engage (CLAUDE.md §11).
 *
 * WHAT IS DELIBERATELY NOT HERE (CLAUDE.md §11)
 * ----------------------------------------------
 *   NO AGGREGATE RATING, NO STAR COUNT, NO REVIEW TOTAL, anywhere on the page
 *   or in the JSON-LD. Five sources gave five irreconcilable numbers — their
 *   own site says "800+", GuildQuality 4.6 from 85, Houzz 4.7 from 77, Yelp
 *   125, and one aggregator claims 5.0 from 258 while attributing a review of a
 *   different company (input/facts.txt CONFLICT #4 and #5). On a page whose
 *   whole argument is "go and check us", an uncheckable "800+ 5-star reviews"
 *   is the one claim on it that would fail its own test.
 *
 *   NO HOURS. Not published by them; third-party listings disagree.
 *   NO BORROWED MANUFACTURER LOGOS. Licensed to them, not to us.
 *   NO PORTRAIT of Jared Green — none is published. He is named, not shown.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroStamp from "../components/sections/HeroStamp.astro";
import ServiceShowcase from "../components/sections/ServiceShowcase.astro";
import BeforeAfter from "../components/sections/BeforeAfter.astro";
import Gallery from "../components/sections/Gallery.astro";
import TheRecord from "../components/sections/TheRecord.astro";
import CredentialLedger from "../components/sections/CredentialLedger.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import PromiseSplit from "../components/sections/PromiseSplit.astro";
import TestimonialPullQuote from "../components/sections/TestimonialPullQuote.astro";
import TestimonialGrid from "../components/sections/TestimonialGrid.astro";
import ProviderBios from "../components/sections/ProviderBios.astro";
import FAQ from "../components/sections/FAQ.astro";
import LocationContact from "../components/sections/LocationContact.astro";
import CTABand from "../components/sections/CTABand.astro";
import MarqueeBand from "../components/sections/MarqueeBand.astro";
import Divider from "../components/core/Divider.astro";

import heroPhoto from "../assets/photos/rpv-03.jpg";
import promisePhoto from "../assets/photos/la-craftsman-01.jpg";
import quotePhoto from "../assets/photos/thousand-oaks-06.jpg";

import { SITE, LICENCE } from "../config/site";
import { localized } from "../lib/content";
import { useTranslations, localeFromUrl } from "../i18n/ui";
import { NAV_LINKS, RECORD_FIELDS, HERO_FACTS, PROMISES } from "../lib/page";

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);

const services = await localized("services", locale);
const credentials = await localized("credentials", locale);
const process = await localized("process", locale);
const faqs = await localized("faq", locale);
const projects = await localized("projects", locale);
const reviews = await localized("testimonials", locale);
const people = await localized("people", locale);

const pairs = projects.filter((p) => p.data.beforePhoto);
const singles = projects.filter((p) => !p.data.beforePhoto);

const galleryItems = singles.map((p) => ({
  image: p.data.photo!,
  alt: p.data.alt!,
  caption: p.data.location
    ? `${p.data.title} · ${p.data.location}`
    : p.data.title,
}));

const featuredReview = reviews.find((r) => r.data.featured);
const otherReviews = reviews.filter((r) => !r.data.featured);

const callLabel = `${t("cta.call")} ${SITE.phone}`;
const callHref = `tel:${SITE.phoneHref}`;

const faqSchema = faqs.map((f) => ({
  question: f.data.question,
  answer: f.data.answer,
}));
---

<BaseLayout
  title="Siding, windows, stucco & roofing — licensed in California since 2010"
  description="Award-winning siding, windows and home exterior contractor serving Greater Los Angeles & San Diego. James Hardie Elite Contractor. CSLB #952272, current and active. Free quote — (877) 792-9082."
  path="/"
  navLinks={NAV_LINKS}
  faq={faqSchema}
  announcement={{
    message: "Upgrade now, pay later — 12 months no interest.",
    href: "/financing-options",
    linkLabel: "See financing options",
    id: "finance-2026",
  }}
>
  {/* 1 — the work itself, full-bleed. Their headline, verbatim. */}
  <HeroStamp
    eyebrow="Los Angeles & San Diego's trusted siding & windows contractor"
    heading="A Home Exterior that Withstands the Test of Time"
    body="We're an award-winning siding, windows and home exterior contractor serving Greater Los Angeles & San Diego, including Orange, Riverside and Ventura counties."
    photo={heroPhoto}
    photoAlt="A single-story Rancho Palos Verdes home finished in white James Hardie lap siding, with new landscaping and a stone stairway, under a clear blue sky."
    captionPlace="Rancho Palos Verdes, CA"
    captionWork="James Hardie lap siding, soffit, fascia and exterior paint"
    ctaHref="/free-estimate"
    ctaLabel="Schedule your free quote"
    telHref={callHref}
    telLabel={callLabel}
    facts={HERO_FACTS}
  />

  {/* 2 — what we actually do. Product before proof. */}
  <ServiceShowcase
    eyebrow="Home exterior services that last"
    heading="Six trades, all of them outdoors."
    body="We're not a general remodeler. There's no kitchen, no bathroom and no addition on this list — everything we do is the outside of your house."
    items={services}
    spacing="default"
  />

  <Divider tone="sunken" />

  {/* 3 — the same house, twice. The strongest thing an exterior firm owns. */}
  {
    pairs.length > 0 && (
      <BeforeAfter
        id="work"
        eyebrow="The same house, twice"
        heading="Stucco off. James Hardie on."
        body="One project in Los Angeles, photographed before we started and after we finished."
        items={pairs}
        tone="sunken"
        spacing="default"
      />
    )
  }

  {
    galleryItems.length > 0 && (
      <Gallery
        locale={locale}
        eyebrow="Recent work"
        heading="Five more, across six counties."
        items={galleryItems}
        layout="uniform"
        tone="sunken"
        spacing="tight"
      />
    )
  }

  {/* 4 — THE SIGNATURE MOMENT. */}
  <TheRecord
    id="record"
    eyebrow="The public record"
    heading="We're called Approved Contractor. Here's the approval."
    body="This is our license as the State of California holds it, not as we describe it. Don't take our word for it — the lookup takes about thirty seconds."
    authority={LICENCE.authority}
    documentTitle={LICENCE.documentTitle}
    fields={RECORD_FIELDS}
    retrieval={`License record current as of ${LICENCE.retrieved}. Bond and policy dates change — check the live record any time.`}
    verifyHref={LICENCE.lookupUrl}
    verifyLabel="Look up license 952272 yourself →"
  />

  {/* 5 — everyone else who has checked us. */}
  <CredentialLedger
    id="credentials"
    eyebrow="Everyone else who has checked"
    heading="Nine more approvals, and who granted each one."
    body="Each one came from someone else — a manufacturer, a trade body, or the state — and every one of them can be looked up."
    items={credentials}
    featureLabel="James Hardie Elite Contractor"
    tone="sunken"
    spacing="default"
  />

  <Divider />

  {/* 6 — what happens when you call. Their four steps, verbatim. */}
  <ProcessSteps
    id="process"
    eyebrow="Our simple process"
    heading="Four steps, and the first one is free."
    body="No aggressive sales, no upsell on things you don't need, and you can stop after any of them."
    steps={process}
    layout="row"
    ctaLabel={callLabel}
    ctaHref={callHref}
    spacing="default"
  />

  {/* 7 — their best writing, finally set like it matters. */}
  <PromiseSplit
    id="promise"
    eyebrow="Our promise to you"
    heading="We treat your home like it's our own."
    body="Don't waste time hiring a sub-par siding, window and home exterior contractor. Get superior customer service, premium products, and optimal results."
    promises={PROMISES}
    photo={promisePhoto}
    photoAlt="A 107-year-old Los Angeles Craftsman home after its original wood siding was replaced with James Hardie ColorPlus lap siding."
    tone="sunken"
    spacing="default"
    ctaLabel="Schedule your free quote"
    ctaHref="/free-estimate"
  />

  {/* The kinetic strip. CSS-only, pointer-free, and the one loud thing
      between the quiet promise section and the reviews. Outline style — a
      solid marquee reads as a sale banner (the component's own note). */}
  <MarqueeBand
    items={[
      "Siding",
      "Windows",
      "Stucco",
      "Paint & texture coating",
      "Roofing",
      "Shutters",
      "Free consultations",
      "CSLB #952272",
    ]}
    tone="brand"
    style="outline"
    size="m"
  />

  {/* 8 — reviews. */}
  {
    featuredReview && (
      <TestimonialPullQuote
        id="review-featured"
        locale={locale}
        eyebrow="In one customer's words"
        testimonial={featuredReview}
        photo={quotePhoto}
        photoAlt="A Thousand Oaks home after its damaged stucco was replaced and the exterior refinished."
        spacing="default"
      />
    )
  }

  {
    otherReviews.length > 0 && (
      <TestimonialGrid
        locale={locale}
        eyebrow="Verified surveys"
        heading="What people said afterwards."
        body="Collected by GuildQuality, which surveys our customers directly and publishes what they say — including the complaints."
        items={otherReviews}
        columns={3}
        tone="sunken"
        spacing="default"
      />
    )
  }

  <Divider />

  {/* 9 — who we are. Late, because nobody hires a contractor for their bio. */}
  {
    people.length > 0 && (
      <ProviderBios
        id="owner"
        eyebrow="Who's responsible"
        heading="There's a name on the license."
        body="California registers one person on every contractor's license as responsible for supervising the work. On license 952272, that's Jared."
        people={people}
        layout="feature"
        spacing="default"
      />
    )
  }

  <FAQ
    id="faq"
    locale={locale}
    eyebrow="Before you call"
    heading="The questions people actually ask."
    items={faqs}
    tone="sunken"
    spacing="default"
  />

  <LocationContact
    id="contact"
    locale={locale}
    eyebrow="Canoga Park"
    heading="Where our trucks go out from."
    body="9015 Eton Avenue — the address on our state license. We serve Los Angeles, San Diego, Orange, Ventura, San Bernardino and Riverside counties."
    showHours={false}
    formSubject="Exterior consultation request"
    spacing="default"
  />

  <CTABand
    heading="Let's take a look at the outside of your house."
    body="Free consultation, and no obligation after it. Tell us what's bothering you about the exterior and we'll tell you what's actually failing."
    ctaLabel={callLabel}
    ctaHref={callHref}
    secondaryLabel="Check our license first"
    secondaryHref={LICENCE.lookupUrl}
    note="CA Lic. #952272 · Class B General Building · Financing available"
    align="split"
    tone="brand"
    class="on-brand--deep"
    spacing="tight"
  />
</BaseLayout>

{
  /*
  ============================================================================
  OPEN ITEMS — full detail, with sources and conflicts, in input/facts.txt §15.

  ONLY THE BUSINESS CAN CLOSE THESE:
   1. A PORTRAIT OF JARED GREEN. Named on the page and on the state record, but
      no photograph of him is published anywhere. Biggest remaining gap.
   2. HOURS. Not published by them; third-party listings disagree on Saturday.
   3. AN EMAIL ADDRESS. Not published, so the contact block omits it.
   4. THE PHONE CONFLICT. Their homepage header shows (866) 215-2968 while their
      contact page, about page AND the CSLB register all show (877) 792-9082.
      This build uses the register's number.
   5. THE REVIEW COUNT. One verifiable source and the number goes back on.
   6. YELP AND GOOGLE REVIEWS — 125 on Yelp alone, none of it machine-readable.
   7. AWARD CURRENCY. The QR Top 500 and HIP 200 badges say 2025.
   8. FINANCING TERMS. Read 2026-08-12; promotional finance moves constantly.

  ENGINEERING, BEFORE ANY CLIENT TEST:
   9. FORM_ENDPOINT is empty, so ContactForm renders its disabled state.
  10. GEO COORDINATES. `geo` is null, so LocalBusiness omits it.

  PAGES DELIBERATELY NOT BUILT — see the scope note in the handoff. Their site
  runs to 37 top-level URLs plus 12 featured-project pages plus a blog. This
  build covers the ten that carry the commercial argument. Deferred: the four
  siding sub-pages, five window sub-pages, individual project pages, both
  buying guides, the blog, video resources, media, and the city landing pages.
  ============================================================================
  */
}
