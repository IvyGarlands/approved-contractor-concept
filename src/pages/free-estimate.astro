---
/**
 * /free-estimate — the hero CTA lands here.
 *
 * Deliberately the shortest page on the site. Someone who has clicked
 * "Schedule your free quote" has already decided; the job of this page is to
 * take their details and get out of the way, not to sell again. One form, the
 * four process steps so they know what they've agreed to, and nothing else.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import LocationContact from "../components/sections/LocationContact.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CTABand from "../components/sections/CTABand.astro";
import PhotoBand from "../components/sections/PhotoBand.astro";
import Divider from "../components/core/Divider.astro";

import heroPhoto from "../assets/photos/la-stucco-to-hardie-after.jpg";

/* Five real jobs, edge to edge, to keep the product in front of someone on a
   page that is otherwise records and lists. See PhotoBand for why alt is "". */
import bandA from "../assets/photos/rpv-03.jpg";
import bandB from "../assets/photos/la-stucco-to-hardie-after.jpg";
import bandC from "../assets/photos/thousand-oaks-08.jpg";
import bandD from "../assets/photos/la-newbuild-01.jpg";
import bandE from "../assets/photos/encino-01.jpg";

import { SITE, LICENCE } from "../config/site";
import { localized } from "../lib/content";
import { useTranslations, localeFromUrl } from "../i18n/ui";
import { NAV_LINKS, CALL_HREF } from "../lib/page";

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const callLabel = `${t("cta.call")} ${SITE.phone}`;
const process = await localized("process", locale);

const bandPhotos = [
  { src: bandA, label: "Rancho Palos Verdes, CA" },
  { src: bandB, label: "Los Angeles, CA" },
  { src: bandC, label: "Thousand Oaks, CA" },
  { src: bandD, label: "Los Angeles, CA" },
  { src: bandE, label: "Encino, CA" },
];
---

<BaseLayout
  title="Schedule your free quote"
  description="Book a free, no-obligation exterior consultation with Approved Contractor, Inc. Siding, windows, stucco, coating and roofing across six Southern California counties."
  path="/free-estimate"
  navLinks={NAV_LINKS}
>
  <PageHero
    eyebrow="Free consultation"
    heading="Schedule your free quote."
    body="No aggressive sales and no upsell on products or services you don't really need. We confirm every appointment before we come out."
    photo={heroPhoto}
    photoAlt="A Los Angeles home after its stucco was replaced with James Hardie lap siding."
    crumbs={[{ label: "Home", href: "/" }]}
  />

  <LocationContact
    id="contact"
    locale={locale}
    eyebrow="Tell us about the house"
    heading="Four fields and we'll call you back."
    body="Or call (877) 792-9082 and speak to someone now."
    showHours={false}
    formSubject="Free estimate request"
    spacing="default"
  />

  <Divider tone="sunken" />

  <PhotoBand photos={bandPhotos} caption="What a finished job looks like" />

  <ProcessSteps
    id="process"
    eyebrow="What you're booking"
    heading="Step one of four, and it costs nothing."
    steps={process}
    layout="row"
    tone="sunken"
    spacing="default"
  />

  <CTABand
    heading="Prefer to talk?"
    body="We answer the phone. Tell us what's bothering you about the outside of the house."
    ctaLabel={callLabel}
    ctaHref={CALL_HREF}
    secondaryLabel="Check our licence"
    secondaryHref={LICENCE.lookupUrl}
    note="CA Lic. #952272 · Free consultations · Financing available"
    align="split"
    tone="brand"
    class="on-brand--deep"
    spacing="tight"
  />
</BaseLayout>
