---
/**
 * /paint-texture-coating — stucco, exterior paint and Cool Life texture coating.
 *
 * REGULATED-CLAIM NOTE. The warranty and durability lines are the client's and
 * the manufacturer's, quoted rather than paraphrased, and nothing is added to
 * them: no lifespan we invented, no energy-saving percentage (they publish
 * none), no "guaranteed" beyond the four failure modes they actually name
 * (input/facts.txt §5). Do not tidy these into better marketing.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/sections/PageHero.astro";
import AboutAlternating from "../components/sections/AboutAlternating.astro";
import TestimonialPullQuote from "../components/sections/TestimonialPullQuote.astro";
import Gallery from "../components/sections/Gallery.astro";
import CTABand from "../components/sections/CTABand.astro";
import Divider from "../components/core/Divider.astro";

import heroPhoto from "../assets/photos/thousand-oaks-03.jpg";
import rowStucco from "../assets/photos/thousand-oaks-08.jpg";
import rowCoating from "../assets/photos/la-jolla-after.jpg";
import rowPaint from "../assets/photos/rpv-03.jpg";
import gTo6 from "../assets/photos/thousand-oaks-06.jpg";
import gTo5 from "../assets/photos/thousand-oaks-05.jpg";
import gRpv from "../assets/photos/rancho-palos-verdes-after.jpg";
import gLaJolla from "../assets/photos/la-jolla-after.jpg";
import quotePhoto from "../assets/photos/rancho-palos-verdes-after.jpg";

import { SITE, LICENCE } from "../config/site";
import { localized } from "../lib/content";
import { useTranslations, localeFromUrl } from "../i18n/ui";
import { NAV_LINKS, CALL_HREF } from "../lib/page";

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const callLabel = `${t("cta.call")} ${SITE.phone}`;

const reviews = await localized("testimonials", locale);
/* Kimberly A.'s review is specifically about the Cool Life coating, so it
   belongs on this page more than anywhere else on the site. */
const coatingReview = reviews.find((r) => r.data.featured);

const rows = [
  {
    heading: "Stucco remediation and application",
    body: "Cracked or failing stucco either gets repaired properly or it comes off. Where the substrate underneath has gone, patching is money thrown away — we'll tell you that at the consultation rather than after the invoice. Several of our own projects are stucco taken off entirely and replaced with fiber cement siding.",
    image: rowStucco,
    alt: "A Thousand Oaks home after damaged stucco was remediated and replaced.",
    meta: [
      { label: "Scope", value: "Remediation & new application" },
      { label: "Often becomes", value: "A siding replacement" },
    ],
  },
  {
    heading: "Cool Life texture coating",
    body: "When your home needs a makeover, turn to the painting and texture coating experts. We only use the very best — giving your home a long-lasting, attractive exterior that won't chip, crack, flake, or peel. Cool Life is heat-reflective: a coated home has a lower exterior surface temperature, which means you benefit from electricity savings.",
    image: rowCoating,
    alt: "An oceanfront La Jolla home finished with Lifetime Plus Cool Life elastomeric texture coating.",
    meta: [
      { label: "Warranty", value: "Lifetime warranty on texture coating" },
      { label: "Guaranteed against", value: "Peeling, chipping, flaking, cracking" },
    ],
  },
  {
    heading: "Exterior paint",
    body: "Straight repainting, where the surface underneath is sound and coating would be over-specifying it. We'd rather sell you the smaller job and be right than the bigger one and be wrong — we don't do gimmicks or pushy upsells.",
    image: rowPaint,
    alt: "A Rancho Palos Verdes home after new siding and exterior painting.",
    meta: [
      { label: "When it's right", value: "Sound substrate, cosmetic fade" },
      { label: "When it isn't", value: "Cracking, chalking or moisture" },
    ],
  },
];

const galleryItems = [
  { image: gTo6, alt: "A Thousand Oaks home after stucco remediation and new siding.", caption: "Stucco remediation · Thousand Oaks, CA" },
  { image: gTo5, alt: "A detail of newly finished exterior wall on a Thousand Oaks home.", caption: "Finished wall · Thousand Oaks, CA" },
  { image: gRpv, alt: "A modern Rancho Palos Verdes home after siding and exterior painting.", caption: "Siding & paint · Rancho Palos Verdes, CA" },
  { image: gLaJolla, alt: "An oceanfront La Jolla home after texture coating.", caption: "Texture coating · La Jolla, CA" },
];
---

<BaseLayout
  title="Stucco, exterior paint & Cool Life texture coating"
  description="Stucco remediation and application, exterior painting, and heat-reflective Cool Life texture coating across Greater Los Angeles and San Diego. CSLB #952272."
  path="/paint-texture-coating"
  navLinks={NAV_LINKS}
>
  <PageHero
    eyebrow="Stucco, paint & texture coating"
    heading="An exterior that won't chip, crack, flake or peel."
    body="Stucco remediation, exterior paint, and heat-reflective Cool Life texture coating — with a lifetime warranty on the texture coating."
    photo={heroPhoto}
    photoAlt="A Thousand Oaks home mid-project, with damaged stucco stripped back before its new exterior goes on."
    crumbs={[{ label: "Home", href: "/" }]}
  />

  <AboutAlternating
    id="detail"
    eyebrow="What we apply"
    heading="Three finishes, and a straight answer about which one you need."
    rows={rows}
    spacing="default"
  />

  <Divider tone="sunken" />

  {
    coatingReview && (
      <TestimonialPullQuote
        id="review-featured"
        locale={locale}
        eyebrow="In one customer's words"
        testimonial={coatingReview}
        photo={quotePhoto}
        photoAlt="A modern Rancho Palos Verdes home after new siding and exterior finishing."
        tone="sunken"
        spacing="default"
      />
    )
  }

  <Gallery
    locale={locale}
    eyebrow="Coating & stucco work"
    heading="Four recent finishes."
    items={galleryItems}
    layout="uniform"
    tone="sunken"
    spacing="tight"
  />

  <CTABand
    heading="Find out whether you need coating or just paint."
    body="Free consultation. We'll look at what the surface is actually doing and tell you the smaller answer if the smaller answer is right."
    ctaLabel={callLabel}
    ctaHref={CALL_HREF}
    secondaryLabel="Check our license"
    secondaryHref={LICENCE.lookupUrl}
    note="CA Lic. #952272 · Lifetime warranty on texture coating · Financing available"
    align="split"
    tone="brand"
    class="on-brand--deep"
    spacing="tight"
  />
</BaseLayout>
