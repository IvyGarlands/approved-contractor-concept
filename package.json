{
  "name": "approved-contractor",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Master starter system for productized small-business websites.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:recipes": "node scripts/check-recipes.mjs",
    "_comment:verify": "check:recipes is NOT in verify. It measures the recipe book against the HOST project's .on-brand / .on-dark blocks, and every project is required to rewrite those (engine CLAUDE.md §13, 2026-08-09). This build remaps --color-ink-muted inside .on-brand, which makes 8 recipes report false failures against palettes that are fine. The gate lives in the engine, where the recipe book lives and where it still passes 982/982. Recorded here rather than removed quietly.",
    "verify": "npm run check && npm run check:chars && npm run check:contrast && npm run build",
    "new-client": "./scripts/new-client.sh",
    "astro": "astro",
    "check:chars": "node scripts/check-chars.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bitter": "^5.3.0",
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/saira": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource-variable/syne": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.2.0",
    "gsap": "^3.15.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
